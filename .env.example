# Server-only Supabase settings. Add these to Netlify environment variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# Private dashboard access. Use two different long, random values.
DASHBOARD_PASSWORD=replace-with-a-private-password
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
